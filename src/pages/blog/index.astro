---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog" description="Writing on cybersecurity, GRC, compliance, and security programme development by Chris Green.">

  <div class="py-16 sm:py-20">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-3">
        Blog
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm max-w-xl">
        Writing on cybersecurity governance, risk, compliance, and security programme development.
      </p>
    </div>

    <div class="flex items-center gap-3 p-5 rounded-xl bg-slate-50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-700/30 text-slate-500 dark:text-slate-400">
      <svg class="w-5 h-5 shrink-0 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      <p class="text-sm">Posts coming soon.</p>
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="py-32 sm:py-40 text-center">
    <p class="text-xs font-semibold tracking-widest uppercase text-cyan-600 dark:text-cyan-500 mb-4">
      404
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-4">
      Page not found
    </h1>
    <p class="text-slate-500 dark:text-slate-400 text-sm max-w-sm mx-auto mb-10">
      The page you're looking for has moved, been removed, or never existed.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400 text-white text-sm font-semibold transition-colors duration-150"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to home
    </a>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const talks = await getCollection('talks');
  return talks.map((talk) => ({
    params: { slug: talk.id.replace(/\.md$/, '') },
    props: { talk },
  }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);

const date = talk.data.date.toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: talk.data.title,
  description: talk.data.description,
  startDate: talk.data.date.toISOString().slice(0, 10),
  location: {
    '@type': 'Place',
    name: talk.data.conference,
    address: talk.data.location ?? '',
  },
  organizer: {
    '@type': 'Organization',
    name: talk.data.conference,
  },
  performer: {
    '@type': 'Person',
    name: 'Chris Green',
    url: 'https://wretiii.com',
  },
};
---

<Layout title={talk.data.title} description={talk.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
  </Fragment>

  <div class="py-16 sm:py-20">

    <!-- Back link -->
    <a href="/talks" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 dark:text-slate-500 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors mb-10">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      All Talks
    </a>

    <!-- Header -->
    <div class="space-y-4 mb-10">
      <p class="text-xs font-semibold tracking-widest uppercase text-cyan-600 dark:text-cyan-500">
        {talk.data.conference}
        {talk.data.location && (
          <span class="text-slate-400 dark:text-slate-600 font-normal normal-case tracking-normal">
            {' '}&middot; {talk.data.location}
          </span>
        )}
      </p>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 leading-snug">
        {talk.data.title}
      </h1>
      <time
        datetime={talk.data.date.toISOString().slice(0, 10)}
        class="block text-sm text-slate-400 dark:text-slate-500"
      >
        {date}
      </time>
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl">
        {talk.data.description}
      </p>
    </div>

    <!-- Topics + Slides -->
    <div class="flex flex-wrap items-center gap-4 mb-10 pb-10 border-b border-slate-200 dark:border-slate-800">
      {talk.data.topics && (
        <div class="flex flex-wrap gap-2">
          {talk.data.topics.map((topic) => (
            <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700/50 font-medium">
              {topic}
            </span>
          ))}
        </div>
      )}
      {talk.data.slidesUrl && (
        <a
          href={talk.data.slidesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400 text-white text-xs font-semibold transition-colors duration-150 ml-auto"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Slides
        </a>
      )}
    </div>

    <!-- Reference links from markdown body -->
    {talk.body && talk.body.trim() && (
      <div>
        <h2 class="text-xs font-semibold tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-6">
          Reference Materials
        </h2>
        <div class="prose-talk">
          <Content />
        </div>
      </div>
    )}

  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';

const allTalks = await getCollection('talks');
const recentTalks = allTalks
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const certifications = ['CISSP', 'OSCP', 'CISA', 'CRISC', 'QSA/PCIP', 'CMMC RP'];
---

<Layout title="Chris Green" description="Cybersecurity consultant, penetration tester, and speaker based in New York. CISSP, OSCP, CISA, CRISC, QSA/PCIP, CMMC RP.">

  <!-- Hero -->
  <section class="pt-20 pb-16 sm:pt-28 sm:pb-20 relative">
    <!-- Radial glow accent -->
    <div
      class="absolute -top-10 -left-20 w-[520px] h-[340px] bg-cyan-500/[0.04] dark:bg-cyan-400/[0.06] rounded-full blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="space-y-6 relative">
      <div class="space-y-2 animate-fade-up" style="animation-delay: 0ms">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
          Chris Green
        </h1>
        <p class="text-sm sm:text-base font-medium tracking-widest uppercase text-slate-400 dark:text-slate-500">
          Security Leader &nbsp;&middot;&nbsp; GRC Strategist &nbsp;&middot;&nbsp; Offensive Security &nbsp;&middot;&nbsp; Speaker
        </p>
      </div>

      <!-- Positioning statement -->
      <p class="text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl animate-fade-up" style="animation-delay: 40ms">
        I help organisations across financial services, healthcare, and critical infrastructure translate regulatory complexity and evolving threats into security programmes that protect operations and inform board-level decisions.
      </p>

      <!-- Certifications -->
      <div class="flex flex-wrap gap-2 animate-fade-up" style="animation-delay: 80ms">
        {certifications.map((cert) => (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-cyan-50 dark:bg-cyan-900/20 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800/50">
            {cert}
          </span>
        ))}
      </div>

      <!-- Social links -->
      <div class="animate-fade-up" style="animation-delay: 160ms">
        <SocialLinks />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="border-t border-slate-200 dark:border-slate-800"></div>

  <!-- Recent Talks -->
  <section class="py-14">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xs font-semibold tracking-widest uppercase text-slate-400 dark:text-slate-500">
        Recent Talks
      </h2>
      <a href="/talks" class="text-xs font-medium text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 dark:hover:text-cyan-300 transition-colors">
        View all &rarr;
      </a>
    </div>

    <div class="space-y-3">
      {recentTalks.map((talk) => {
        const date = talk.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
        return (
          <a
            href={`/talks/${talk.id.replace(/\.md$/, '')}`}
            class="group flex items-start justify-between gap-6 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/50 hover:border-cyan-300 dark:hover:border-cyan-700/50 hover:bg-white dark:hover:bg-slate-800 transition-all duration-150"
          >
            <div class="min-w-0">
              <p class="text-xs font-semibold tracking-wide uppercase text-cyan-600 dark:text-cyan-500 mb-1">
                {talk.data.conference}
              </p>
              <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-slate-900 dark:group-hover:text-white leading-snug">
                {talk.data.title}
              </p>
            </div>
            <time
              datetime={talk.data.date.toISOString().slice(0, 10)}
              class="shrink-0 text-xs font-medium text-slate-400 dark:text-slate-500 pt-0.5 whitespace-nowrap"
            >
              {date}
            </time>
          </a>
        );
      })}
    </div>
  </section>

</Layout>
